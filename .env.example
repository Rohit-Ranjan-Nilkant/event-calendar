# ─────────────────────────────────────────────────────────────────────────────
# Event Calendar — environment variables
#
# Copy this file to .env and fill in your values.
#
# For Docker Compose deployment: these vars are read by docker-compose.yml.
# For local development:
#   backend/  → create backend/.env
#   frontend  → create .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker Compose manages the server) ───────────────────────────
POSTGRES_DB="eventcalendar"
POSTGRES_USER="ecuser"
POSTGRES_PASSWORD="change-me-strong-password"

# ── Backend (Express) ────────────────────────────────────────────────────────
# Constructed automatically in docker-compose.yml from the POSTGRES_* vars above.
# Set manually only when running the backend outside of Docker Compose.
DATABASE_URL="postgresql://ecuser:change-me-strong-password@localhost:5432/eventcalendar"

# JWT session signing secret — use a long random string (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Anthropic API key — required for LLM-powered event crawling (Super Admin only)
ANTHROPIC_API_KEY="sk-ant-..."

# Default admin user (created by running seed in the backend directory)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourSecurePassword!"

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Internal URL the Next.js server uses to reach the Express backend.
# In Docker Compose this is http://backend:4000 (the service name).
# In local dev this is http://localhost:4000.
BACKEND_INTERNAL_URL="http://backend:4000"

# Public URL of the frontend — used by the backend for CORS.
FRONTEND_URL="https://yourdomain.com"
